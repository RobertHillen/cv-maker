{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "npm",
            "script": "start",
            "isBackground": true,
            "label": "npm: start",
            "problemMatcher": {
                "owner": "typescript",
                "pattern": "$tsc",
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "(.*?)Building(.*?)",
                    "endsPattern": "(.*?)(Compiled successfully|bundle generation complete|Watch mode enabled)(.*?)"
                }
            }
        }
    ]
}
